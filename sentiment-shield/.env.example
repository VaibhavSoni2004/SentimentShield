# ==============================================================================
# ComplaintFlow Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit the real .env file or real secrets to version control.
# ==============================================================================

# Environment mode: 'development' or 'production'
# In production, the app strictly requires a secure SECRET_KEY and PostgreSQL DATABASE_URL.
ENVIRONMENT=development

# JWT Secret Key:
# - In development: defaults to 'dev-secret-key'.
# - In production: generate a secure 64-char hex key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key

# JWT Token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL:
# - In development: leave unset to use local SQLite (feedback.db), or set to a test database.
# - In production (Render + Supabase): paste your Supabase PostgreSQL connection URI.
#   Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#   Note: If your password contains special characters (e.g., @, #, %, &, !), URL-encode them (e.g. '@' -> '%40', '#' -> '%23').
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Google Gemini API Configuration:
# - GEMINI_API_KEY is required for Gemini cloud classification.
# - If missing or if Gemini API is unreachable, the offline rule-based fallback automatically handles feedback.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000

# Initial Administrator Bootstrap Account (auto-created on first startup if configured)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

